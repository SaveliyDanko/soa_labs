<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:itmo:soa:isu:v1" targetNamespace="urn:itmo:soa:isu:v1" name="IsuService">
    <wsdl:documentation>ISU SOAP 1.1 API. Business validation and collection operations belong to this service.</wsdl:documentation>
    <wsdl:types>
        <xs:schema targetNamespace="urn:itmo:soa:isu:v1" elementFormDefault="qualified">
            <xs:complexType name="Coordinates"><xs:sequence>
                <xs:element name="x" type="xs:float"/><xs:element name="y" type="xs:float"/>
            </xs:sequence></xs:complexType>
            <xs:complexType name="Location"><xs:sequence>
                <xs:element name="x" type="xs:long"/><xs:element name="y" type="xs:double"/><xs:element name="z" type="xs:double"/>
            </xs:sequence></xs:complexType>
            <xs:complexType name="Person"><xs:sequence>
                <xs:element name="name" type="xs:string"/>
                <xs:element name="birthday" type="xs:dateTime" minOccurs="0"/>
                <xs:element name="hairColor" type="xs:string" minOccurs="0"/>
                <xs:element name="nationality" type="xs:string"/>
                <xs:element name="location" type="tns:Location" minOccurs="0"/>
            </xs:sequence></xs:complexType>
            <xs:complexType name="StudyGroup"><xs:sequence>
                <xs:element name="id" type="xs:int"/><xs:element name="creationDate" type="xs:dateTime"/>
                <xs:element name="name" type="xs:string"/><xs:element name="coordinates" type="tns:Coordinates"/>
                <xs:element name="studentsCount" type="xs:long"/><xs:element name="formOfEducation" type="xs:string"/>
                <xs:element name="semesterEnum" type="xs:string" minOccurs="0"/>
                <xs:element name="groupAdmin" type="tns:Person" minOccurs="0"/>
            </xs:sequence></xs:complexType>
            <xs:complexType name="ActionResult"><xs:sequence>
                <xs:element name="code" type="xs:string"/><xs:element name="message" type="xs:string"/>
                <xs:element name="resourceId" type="xs:int"/>
            </xs:sequence></xs:complexType>
            <xs:complexType name="ErrorDetail"><xs:sequence>
                <xs:element name="name" type="xs:string"/><xs:element name="value" type="xs:string"/>
            </xs:sequence></xs:complexType>
            <xs:element name="IsuFault"><xs:complexType><xs:sequence>
                <xs:element name="status" type="xs:int"/><xs:element name="code" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
                <xs:element name="detail" type="tns:ErrorDetail" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence></xs:complexType></xs:element>
            <xs:element name="expelAll"><xs:complexType><xs:sequence>
                <xs:element name="groupId" type="xs:string"/>
            </xs:sequence></xs:complexType></xs:element>
            <xs:element name="expelAllResponse"><xs:complexType><xs:sequence>
                <xs:element name="result" type="tns:ActionResult"/>
            </xs:sequence></xs:complexType></xs:element>
            <xs:element name="changeEducationForm"><xs:complexType><xs:sequence>
                <xs:element name="groupId" type="xs:string"/><xs:element name="newForm" type="xs:string"/>
            </xs:sequence></xs:complexType></xs:element>
            <xs:element name="changeEducationFormResponse"><xs:complexType><xs:sequence>
                <xs:element name="result" type="tns:StudyGroup"/>
            </xs:sequence></xs:complexType></xs:element>
        </xs:schema>
    </wsdl:types>
    <wsdl:message name="expelAll"><wsdl:part name="parameters" element="tns:expelAll"/></wsdl:message>
    <wsdl:message name="expelAllResponse"><wsdl:part name="parameters" element="tns:expelAllResponse"/></wsdl:message>
    <wsdl:message name="changeEducationForm"><wsdl:part name="parameters" element="tns:changeEducationForm"/></wsdl:message>
    <wsdl:message name="changeEducationFormResponse"><wsdl:part name="parameters" element="tns:changeEducationFormResponse"/></wsdl:message>
    <wsdl:message name="IsuFaultMessage"><wsdl:part name="fault" element="tns:IsuFault"/></wsdl:message>
    <wsdl:portType name="IsuPortType">
        <wsdl:operation name="expelAll"><wsdl:documentation>Expel all students by deleting the empty group.</wsdl:documentation>
            <wsdl:input message="tns:expelAll"/><wsdl:output message="tns:expelAllResponse"/><wsdl:fault name="IsuFault" message="tns:IsuFaultMessage"/>
        </wsdl:operation>
        <wsdl:operation name="changeEducationForm"><wsdl:documentation>Change only the group's education form.</wsdl:documentation>
            <wsdl:input message="tns:changeEducationForm"/><wsdl:output message="tns:changeEducationFormResponse"/><wsdl:fault name="IsuFault" message="tns:IsuFaultMessage"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="IsuSoapBinding" type="tns:IsuPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="expelAll"><soap:operation soapAction="urn:itmo:soa:isu:v1:expelAll"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="IsuFault"><soap:fault name="IsuFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
        <wsdl:operation name="changeEducationForm"><soap:operation soapAction="urn:itmo:soa:isu:v1:changeEducationForm"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output>
            <wsdl:fault name="IsuFault"><soap:fault name="IsuFault" use="literal"/></wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="IsuService"><wsdl:port name="IsuPort" binding="tns:IsuSoapBinding">
        <soap:address location="http://isu-service:8080/soap/isu"/>
    </wsdl:port></wsdl:service>
</wsdl:definitions>
