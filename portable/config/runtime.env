# Public listeners. On Helios replace these with the ports assigned to you.
CLIENT_BIND_ADDRESS=0.0.0.0
CLIENT_HTTPS_PORT=3000
PAYARA_BIND_ADDRESS=0.0.0.0
PAYARA_HTTPS_PORT=8181
WILDFLY_BIND_ADDRESS=0.0.0.0
WILDFLY_HTTPS_PORT=8443

# Payara allocates its internal listeners from this base:
# admin=base+48, HTTP=base+80, HTTPS=base+81. HTTP is disabled after the
# one-time configuration. Pick an unused block on a shared host.
PAYARA_PORT_BASE=8100

# WildFly's HTTP and management listeners are loopback-only, but their ports
# still have to be unique on a shared host.
WILDFLY_HTTP_PORT=8080
WILDFLY_MANAGEMENT_PORT=9990

# The generated laboratory keystore and the default Payara domain both use
# this password. Keep it as changeit unless the domain is reconfigured too.
TLS_STORE_PASSWORD=changeit

# Number of seconds to wait for each service during startup/shutdown.
STARTUP_TIMEOUT_SECONDS=90
SHUTDOWN_TIMEOUT_SECONDS=30

# Low-resource profile for shared university servers. ActiveProcessorCount is
# especially important: application servers otherwise size many pools from the
# total CPU count of the Helios host rather than from this account's limits.
ACTIVE_PROCESSOR_COUNT=2
JAVA_THREAD_STACK_SIZE=256k
PAYARA_MAX_HEAP=320m
WILDFLY_MAX_HEAP=320m
CLIENT_MAX_HEAP=96m
CLIENT_WORKER_THREADS=4
